{
  "name": "@svitlo/biology",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "package:build": "node ../../scripts/textbook-tooling/build.mjs",
    "code:check:types": "tsc -p tsconfig.json --noEmit",
    "code:lint:check": "eslint textbook.ts",
    "pretest:publish": "npm run package:build --workspace @svitlo/biology",
    "test:publish": "node --test ../../scripts/textbook-tooling/test-publish.mjs",
    "pretest:portability": "npm run package:build --workspace @svitlo/biology",
    "test:portability": "node ../../scripts/textbook-tooling/check-portability.mjs",
    "prepack": "npm run package:build",
    "code:format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "code:format:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "code:lint:fix": "eslint textbook.ts --fix"
  },
  "bin": {
    "svitlo-biology": "./dist/publish.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@svitlo/engine": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "eslint": "^9",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0"
  },
  "exports": {
    ".": {
      "types": "./dist/textbook/index.d.ts",
      "default": "./dist/textbook/index.js"
    }
  }
}
