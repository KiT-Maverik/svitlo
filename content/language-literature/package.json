{
  "name": "@svitlo/language-literature",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/textbook-tooling/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest:publish": "npm run build --workspace @svitlo/language-literature",
    "test:publish": "node --test ../../scripts/textbook-tooling/test-publish.mjs",
    "pretest:portability": "npm run build --workspace @svitlo/language-literature",
    "test:portability": "node ../../scripts/textbook-tooling/check-portability.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "svitlo-language-literature": "./dist/publish.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "typescript": "^5"
  },
  "exports": {
    ".": {
      "types": "./dist/textbook/index.d.ts",
      "default": "./dist/textbook/index.js"
    }
  }
}
