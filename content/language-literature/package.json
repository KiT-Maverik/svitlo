{
  "name": "@svitlo/language-literature",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest:publish": "npm run build --workspace @svitlo/language-literature",
    "test:publish": "node --test scripts/publish.spec.mjs",
    "pretest:portability": "npm run build --workspace @svitlo/language-literature",
    "test:portability": "node scripts/check-react-dom-portability.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "svitlo-language-literature": "./scripts/publish.mjs"
  },
  "files": [
    "dist",
    "scripts/publish.mjs"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "typescript": "^5"
  },
  "exports": {
    ".": {
      "types": "./dist/textbook/index.d.ts",
      "default": "./dist/textbook/index.js"
    }
  }
}
