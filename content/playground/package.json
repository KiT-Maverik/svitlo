{
  "name": "@svitlo/playground",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "generate:scenes": "node scripts/generate-scenes.mjs --write",
    "check:scenes": "node scripts/generate-scenes.mjs --check",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:components": "vitest run",
    "test:components:coverage": "vitest run --coverage",
    "pretest:portability": "npm run build --workspace @svitlo/contracts && npm run build --workspace @svitlo/engine && npm run build --workspace @svitlo/ui-kit",
    "test:portability": "node scripts/check-react-dom-portability.mjs"
  },
  "dependencies": {
    "@mui/material": "^9.5.0",
    "react": "19.3.0",
    "@svitlo/engine": "0.0.0",
    "@svitlo/ui-kit": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "prettier": "3.9.10",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "esbuild": "^0.28.2",
    "react-dom": "19.3.0"
  },
  "exports": {
    ".": {
      "types": "./textbook.ts",
      "default": "./textbook.ts"
    },
    "./scenes": {
      "types": "./scenes/index.ts",
      "default": "./scenes/index.ts"
    }
  }
}
