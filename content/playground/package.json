{
  "name": "@svitlo/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:scenes": "node scripts/generate-scenes.mjs --write",
    "check:scenes": "node scripts/generate-scenes.mjs --check",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.types.json --noEmit",
    "test:components": "vitest run",
    "test:components:coverage": "vitest run --coverage",
    "pretest:portability": "npm run build --workspace @svitlo/playground",
    "test:portability": "node scripts/check-react-dom-portability.mjs",
    "pretest:publish": "npm run build --workspace @svitlo/playground",
    "test:publish": "node --test scripts/publish.spec.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "svitlo-playground": "./scripts/publish.mjs"
  },
  "files": [
    "dist",
    "scripts/publish.mjs"
  ],
  "dependencies": {
    "@svitlo/engine": "0.0.0",
    "@svitlo/ui-kit": "0.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "prettier": "3.9.10",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "esbuild": "^0.28.2",
    "react-dom": "19.3.0",
    "@mui/material": "^9.5.0",
    "react": "19.3.0"
  },
  "exports": {
    ".": {
      "types": "./dist/textbook/index.d.ts",
      "default": "./dist/textbook/index.js"
    },
    "./scenes": {
      "types": "./dist/scenes/index.d.ts",
      "default": "./dist/scenes/index.js"
    },
    "./demo-questions": {
      "types": "./dist/textbook/questionsDemo.d.ts",
      "default": "./dist/textbook/questionsDemo.js"
    },
    "./styles": {
      "default": "./dist/styles.css"
    }
  },
  "peerDependencies": {
    "@mui/material": "^9.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
