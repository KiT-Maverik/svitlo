{
  "name": "@svitlo/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:generate:scenes": "node ../../scripts/textbook-tooling/generate-scenes.mjs --write",
    "content:check:scenes": "node ../../scripts/textbook-tooling/generate-scenes.mjs --check",
    "package:build": "node ../../scripts/textbook-tooling/build.mjs",
    "code:check:types": "tsc -p tsconfig.json --noEmit",
    "test:components": "vitest run",
    "test:components:coverage": "vitest run --coverage",
    "pretest:portability": "npm run package:build --workspace @svitlo/playground",
    "test:portability": "node ../../scripts/textbook-tooling/check-portability.mjs",
    "pretest:publish": "npm run package:build --workspace @svitlo/playground",
    "test:publish": "node --test ../../scripts/textbook-tooling/test-publish.mjs test-course-output.mjs",
    "prepack": "npm run package:build",
    "code:format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "code:format:fix": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@svitlo/engine": "0.0.0",
    "@svitlo/ui-kit": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "prettier": "3.9.10",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "esbuild": "^0.28.2",
    "react-dom": "19.3.0",
    "@mui/material": "^9.5.0",
    "react": "19.3.0"
  },
  "bin": {
    "svitlo-playground": "./dist/publish.mjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/textbook/index.d.ts",
      "default": "./dist/textbook/index.js"
    },
    "./scenes": {
      "types": "./dist/scenes/index.d.ts",
      "default": "./dist/scenes/index.js"
    },
    "./styles": {
      "default": "./dist/styles.css"
    }
  },
  "peerDependencies": {
    "@mui/material": "^9.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
