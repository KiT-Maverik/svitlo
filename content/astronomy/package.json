{
  "name": "@svitlo/astronomy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "package:build": "node ../../scripts/textbook-tooling/buildTextbook/build.mjs",
    "code:check:types": "tsc -p tsconfig.json --noEmit",
    "code:lint:check": "eslint textbook.ts scenes",
    "pretest:publish": "npm run package:build --workspace @svitlo/astronomy",
    "test:publish": "node --test ../../scripts/textbook-tooling/publishTextbook/test-publish.mjs",
    "pretest:portability": "npm run package:build --workspace @svitlo/astronomy",
    "test:portability": "node ../../scripts/textbook-tooling/checkPortability/check-portability.mjs",
    "prepack": "npm run package:build",
    "code:format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "code:format:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "code:lint:fix": "eslint textbook.ts scenes --fix",
    "content:generate:scenes": "node ../../scripts/textbook-tooling/generateScenes/generate-scenes.mjs --write",
    "content:check:scenes": "node ../../scripts/textbook-tooling/generateScenes/generate-scenes.mjs --check",
    "test:components": "vitest run",
    "code:check:scenes": "tsc -p tsconfig.scenes.json --noEmit",
    "test": "npm run code:check:scenes && vitest run"
  },
  "dependencies": {
    "@svitlo/engine": "0.0.0",
    "@svitlo/ui-kit": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "eslint": "^9",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vitest": "^3.2.4",
    "prettier": "3.9.10"
  },
  "bin": {
    "svitlo-astronomy": "./dist/publish.mjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/textbook/index.d.ts",
      "default": "./dist/textbook/index.js"
    },
    "./scenes": {
      "types": "./dist/scenes/index.d.ts",
      "default": "./dist/scenes/index.js"
    },
    "./styles": {
      "default": "./dist/styles.css"
    }
  },
  "imports": {
    "#lessonsData/*": "./data/lessons/*.ts",
    "#coursesData/*": "./data/courses/*.ts"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
