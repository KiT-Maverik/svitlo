{
  "name": "@svitlo/informatics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/textbook-tooling/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint textbook.ts",
    "pretest:publish": "npm run build --workspace @svitlo/informatics",
    "test:publish": "node --test ../../scripts/textbook-tooling/test-publish.mjs",
    "pretest:portability": "npm run build --workspace @svitlo/informatics",
    "test:portability": "node ../../scripts/textbook-tooling/check-portability.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "svitlo-informatics": "./dist/publish.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@svitlo/engine": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "eslint": "^9",
    "@typescript-eslint/parser": "^8.72.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0"
  },
  "exports": {
    ".": {
      "types": "./dist/textbook/index.d.ts",
      "default": "./dist/textbook/index.js"
    }
  }
}
