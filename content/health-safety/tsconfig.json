{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowJs": true,
    "jsx": "react-jsx"
  },
  "include": [
    "textbook.ts",
    "data/**/*.ts",
    "scenes/**/*.ts",
    "scenes/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test-results"
  ]
}
