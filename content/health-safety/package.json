{
  "name": "@svitlo/health-safety",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint scripts/*.mjs",
    "pretest:portability": "npm run build --workspace @svitlo/health-safety",
    "test:portability": "node scripts/check-react-dom-portability.mjs",
    "pretest:publish": "npm run build --workspace @svitlo/health-safety",
    "test:publish": "node --test scripts/publish.spec.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "svitlo-health-safety": "./scripts/publish.mjs"
  },
  "files": [
    "dist",
    "scripts/publish.mjs"
  ],
  "dependencies": {
    "@svitlo/engine": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "typescript": "^5",
    "esbuild": "^0.28.2"
  },
  "exports": {
    ".": {
      "types": "./dist/textbook/index.d.ts",
      "default": "./dist/textbook/index.js"
    },
    "./scenes": {
      "types": "./dist/scenes/index.d.ts",
      "default": "./dist/scenes/index.js"
    }
  }
}
