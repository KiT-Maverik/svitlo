{
  "name": "@svitlo/engineering",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/textbook-tooling/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint textbook.ts",
    "pretest:portability": "npm run build --workspace @svitlo/engineering",
    "test:portability": "node ../../scripts/textbook-tooling/check-portability.mjs",
    "pretest:publish": "npm run build --workspace @svitlo/engineering",
    "test:publish": "node --test ../../scripts/textbook-tooling/test-publish.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "svitlo-engineering": "./dist/publish.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@svitlo/engine": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "eslint": "^9",
    "typescript": "^5",
    "esbuild": "^0.28.2"
  },
  "exports": {
    ".": {
      "types": "./dist/textbook/index.d.ts",
      "default": "./dist/textbook/index.js"
    },
    "./scenes": {
      "types": "./dist/scenes/index.d.ts",
      "default": "./dist/scenes/index.js"
    }
  }
}
