{
  "name": "@svitlo/math",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest:publish": "npm run build --workspace @svitlo/math",
    "test:publish": "node --test scripts/publish.spec.mjs",
    "pretest:portability": "npm run build --workspace @svitlo/math",
    "test:portability": "node scripts/check-react-dom-portability.mjs",
    "prepack": "npm run build",
    "test": "vitest run src/types/languages.unit.spec.ts src/types/languages.contentBlocks.unit.spec.ts",
    "test:types": "tsc -p tsconfig.types.json --noEmit",
    "test:components": "vitest run src/types/languages.unit.spec.ts src/types/languages.contentBlocks.unit.spec.ts"
  },
  "bin": {
    "svitlo-math": "./scripts/publish.mjs"
  },
  "files": [
    "dist",
    "scripts/publish.mjs"
  ],
  "dependencies": {
    "@svitlo/engine": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "@svitlo/ui-kit": "0.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/textbook/index.d.ts",
      "default": "./dist/textbook/index.js"
    }
  }
}
