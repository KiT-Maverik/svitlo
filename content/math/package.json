{
  "name": "@svitlo/math",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc -p tsconfig.types.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/data/skillsTaxonomy/__tests__/*.spec.js",
    "test:e2e": "playwright test",
    "test:db-utils": "npm run test:db-utils --workspace @svitlo/indexdb",
    "test:db-utils:coverage": "npm run test:db-utils:coverage --workspace @svitlo/indexdb",
    "test:db:coverage": "npm run test:db:coverage --workspace @svitlo/indexdb",
    "test:db-controllers-unit": "npm run test:db-controllers-unit --workspace @svitlo/indexdb",
    "test:db-controllers-unit:coverage": "npm run test:db-controllers-unit:coverage --workspace @svitlo/indexdb",
    "test:e2e:db": "npm run test:e2e:db --workspace @svitlo/indexdb",
    "test:components": "vitest run",
    "test:components:coverage": "vitest run --coverage",
    "prebuild": "node --import @svitlo/ui-kit/sync-flags --eval \"\"",
    "predev": "node --import @svitlo/ui-kit/sync-flags --eval \"\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "zod": "^4.6.7",
    "@svitlo/engine": "0.0.0",
    "@svitlo/ui-kit": "0.0.0",
    "@svitlo/indexdb": "0.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "prettier": "3.9.10",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
