{
  "name": "@svitlo/math",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "package:build": "node ../../scripts/textbook-tooling/build.mjs",
    "code:check:types": "tsc -p tsconfig.json --noEmit",
    "pretest:publish": "npm run package:build --workspace @svitlo/math",
    "test:publish": "node --test ../../scripts/textbook-tooling/test-publish.mjs",
    "pretest:portability": "npm run package:build --workspace @svitlo/math",
    "test:portability": "node ../../scripts/textbook-tooling/check-portability.mjs",
    "prepack": "npm run package:build",
    "test": "vitest run src/types/languages.unit.spec.ts src/types/languages.contentBlocks.unit.spec.ts",
    "test:types": "tsc -p tsconfig.types.json --noEmit",
    "test:components": "vitest run src/types/languages.unit.spec.ts src/types/languages.contentBlocks.unit.spec.ts",
    "code:format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "code:format:fix": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@svitlo/engine": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "@svitlo/ui-kit": "0.0.0"
  },
  "bin": {
    "svitlo-math": "./dist/publish.mjs"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/textbook/index.d.ts",
      "default": "./dist/textbook/index.js"
    }
  }
}
