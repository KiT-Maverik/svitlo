{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svitlo.dev/studio/lesson-methodology-frontmatter.schema.json",
  "title": "Lesson Methodologist Brief YAML frontmatter",
  "description": "Validate YAML frontmatter of methodology.md, not full Markdown; approval is editorial.",
  "type": "object",
  "required": [
    "documentLanguage",
    "supportedLanguages",
    "assessmentPlan"
  ],
  "properties": {
    "documentLanguage": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "supportedLanguages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}$"
      }
    },
    "assessmentPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quizRequired",
        "quizzes"
      ],
      "properties": {
        "quizRequired": {
          "type": "boolean"
        },
        "quizzes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quizRequirement"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "quizRequired": {
                "const": true
              }
            },
            "required": [
              "quizRequired"
            ]
          },
          "then": {
            "properties": {
              "quizzes": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "quizzes": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "quizRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "purpose",
        "targetSkills",
        "requiredAssessmentMethods"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "targetSkills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "requiredAssessmentMethods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "retrieval",
              "interpretation",
              "application",
              "classification",
              "relationshipMapping",
              "representationTranslation",
              "missingInformationInference",
              "structuralAnalysis",
              "patternGeneralization",
              "analogicalReasoning",
              "knowledgeTransfer",
              "prediction",
              "errorDiagnosis",
              "verification",
              "justification",
              "knowledgeConstruction"
            ]
          }
        },
        "evidenceIntent": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
