{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Svitlo Course TOC editorial plan",
  "description": "Machine-readable skill-based learning sequence, not published Course_Toc or Lesson configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "courseId",
    "documentLanguage",
    "content",
    "openIssues"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "course-toc-plan"
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "courseId": {
      "$ref": "#/$defs/uuid"
    },
    "documentLanguage": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/module"
          },
          {
            "$ref": "#/$defs/chapter"
          },
          {
            "$ref": "#/$defs/lesson"
          }
        ]
      }
    },
    "openIssues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/openIssue"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "pattern": "^content/[^/]+/data/skills/.+\\.data\\.ts$"
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "title",
        "objective",
        "skills"
      ],
      "properties": {
        "type": {
          "const": "lesson"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "type": "string",
          "minLength": 1
        },
        "sequenceReason": {
          "type": "string",
          "minLength": 1
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/skill"
          }
        },
        "lessonId": {
          "$ref": "#/$defs/uuid"
        },
        "lessonSelectionNote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "title",
        "children"
      ],
      "properties": {
        "type": {
          "const": "chapter"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/lesson"
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "title",
        "children"
      ],
      "properties": {
        "type": {
          "const": "module"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/chapter"
              },
              {
                "$ref": "#/$defs/lesson"
              }
            ]
          }
        }
      }
    },
    "openIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": [
            "missing-skill",
            "prerequisite-conflict",
            "sequence-conflict",
            "scope-ambiguity",
            "taxonomy-unverified",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "suggestedPlacement": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
