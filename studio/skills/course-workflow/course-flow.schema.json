{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svitlo.org/studio/schemas/course-flow.schema.json",
  "title": "Svitlo temporary Course editorial plan (not Engine Config YAML)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "documentLanguage", "supportedLanguages", "methodology"],
  "properties": {
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "type": {
      "const": "course"
    },
    "slug": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "documentLanguage": {
      "$ref": "#/$defs/language"
    },
    "supportedLanguages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "methodology": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "required": ["purpose", "audience", "approach"],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "approach": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "depth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "accessibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "entryConditions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sourceNotes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "outcomes": {
      "$ref": "#/$defs/competencies"
    },
    "prerequisites": {
      "$ref": "#/$defs/competencies"
    },
    "standardsAlignment": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/standardAlignment"
      }
    },
    "content": {
      "$ref": "#/$defs/courseCollection"
    },
    "openDecisions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "age": {
      "$ref": "#/$defs/ageRange"
    },
    "grade": {
      "$ref": "#/$defs/gradeRange"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$"
    },
    "competencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "skillGroups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "skillDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "courses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "standardAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standardId", "status", "evidence"],
      "properties": {
        "standardId": {
          "$ref": "#/$defs/uuid"
        },
        "status": {
          "enum": ["intended", "partial", "verified"]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "courseCollection": {
      "$ref": "#/$defs/collection"
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "order"],
      "properties": {
        "items": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/slug"
          },
          "additionalProperties": {
            "$ref": "#/$defs/child"
          }
        },
        "order": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "child": {
      "oneOf": [
        {
          "$ref": "#/$defs/module"
        },
        {
          "$ref": "#/$defs/chapter"
        },
        {
          "$ref": "#/$defs/lesson"
        }
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "slug", "title", "methodology"],
      "properties": {
        "type": {
          "const": "module"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "methodology": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "outcomes": {
          "$ref": "#/$defs/competencies"
        },
        "prerequisites": {
          "$ref": "#/$defs/competencies"
        },
        "content": {
          "$ref": "#/$defs/collection"
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "slug", "title", "methodology"],
      "properties": {
        "type": {
          "const": "chapter"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "methodology": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "outcomes": {
          "$ref": "#/$defs/competencies"
        },
        "prerequisites": {
          "$ref": "#/$defs/competencies"
        },
        "content": {
          "$ref": "#/$defs/collection"
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "slug", "title", "objective", "skills"],
      "properties": {
        "type": {
          "const": "lesson"
        },
        "lessonId": {
          "$ref": "#/$defs/uuid"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          },
          "minItems": 1
        },
        "depth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sequenceReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "matchingRationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "ageRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 125
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 125
        }
      }
    },
    "gradeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        }
      }
    }
  }
}
