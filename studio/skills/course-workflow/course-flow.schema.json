{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svitlo.org/studio/schemas/course-flow.schema.json",
  "title": "Svitlo single temporary Course authoring specification (removed after materialization)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "documentLanguage",
    "supportedLanguages",
    "methodology"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "type": {
      "const": "course"
    },
    "slug": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "documentLanguage": {
      "$ref": "#/$defs/language"
    },
    "supportedLanguages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "methodology": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "required": [
        "purpose",
        "audience",
        "approach"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "approach": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "depth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "accessibility": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "entryConditions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sourceNotes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "outcomes": {
      "$ref": "#/$defs/competencies"
    },
    "prerequisites": {
      "$ref": "#/$defs/competencies"
    },
    "standardsAlignment": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/standardAlignment"
      }
    },
    "content": {
      "$ref": "#/$defs/courseCollection"
    },
    "openDecisions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "age": {
      "$ref": "#/$defs/ageRange"
    },
    "grade": {
      "$ref": "#/$defs/gradeRange"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$"
    },
    "competencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "skillGroups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "skillDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "courses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "standardAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standardId",
        "status",
        "evidence"
      ],
      "properties": {
        "standardId": {
          "$ref": "#/$defs/uuid"
        },
        "status": {
          "enum": [
            "intended",
            "partial",
            "verified"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "courseCollection": {
      "$ref": "#/$defs/collection"
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "order"
      ],
      "properties": {
        "items": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/slug"
          },
          "additionalProperties": {
            "$ref": "#/$defs/child"
          }
        },
        "order": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "child": {
      "oneOf": [
        {
          "$ref": "#/$defs/module"
        },
        {
          "$ref": "#/$defs/chapter"
        },
        {
          "$ref": "#/$defs/lesson"
        },
        {
          "$ref": "#/$defs/episode"
        }
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "slug",
        "title",
        "methodology"
      ],
      "properties": {
        "type": {
          "const": "module"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "methodology": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "outcomes": {
          "$ref": "#/$defs/competencies"
        },
        "prerequisites": {
          "$ref": "#/$defs/competencies"
        },
        "content": {
          "$ref": "#/$defs/collection"
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "slug",
        "title",
        "methodology"
      ],
      "properties": {
        "type": {
          "const": "chapter"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "methodology": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "outcomes": {
          "$ref": "#/$defs/competencies"
        },
        "prerequisites": {
          "$ref": "#/$defs/competencies"
        },
        "content": {
          "$ref": "#/$defs/collection"
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "slug",
        "title",
        "objective",
        "skills"
      ],
      "properties": {
        "type": {
          "const": "lesson"
        },
        "lessonId": {
          "$ref": "#/$defs/uuid"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/uuid"
          },
          "minItems": 1
        },
        "depth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "sequenceReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "matchingRationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "methodology": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000,
          "description": "Complete methodology for a planned Lesson. Instructional Lessons are reusable; assessment-only Lessons may describe upstream Course Lesson slots and external Question Bank intent. Stage 5 creates the minimal lesson.yaml and persistent UUID."
        },
        "quizRequired": {
          "type": "boolean",
          "description": "Optional explicit Quiz intent for the initial Lesson YAML shell; the complete plan remains in methodology."
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "description": "Supported Course-local Lesson parameters only; identity, Skill IDs and languages are immutable.",
          "properties": {
            "disabled": {
              "const": true
            },
            "quizRequiredForCompletion": {
              "type": "boolean"
            },
            "sections": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "allowNavigation": {
                  "type": "boolean"
                },
                "allowSkipping": {
                  "type": "boolean"
                },
                "showIndexes": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "locale": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title"
          ],
          "properties": {
            "title": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": {
                    "$ref": "#/$defs/language"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            }
          }
        },
        "events": {
          "type": "object",
          "description": "JSON event values; canonical Engine Lesson Override schema validates effective typed values.",
          "additionalProperties": true
        },
        "section": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "description": "Optional Course-local Section patch using the existing stateless nested Build API; canonical Lesson Build API validates effective children and nested values.",
          "properties": {
            "items": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/slug"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "const": false
                  },
                  {
                    "type": "object"
                  }
                ]
              }
            },
            "additionalItems": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/slug"
              },
              "additionalProperties": {
                "type": "object"
              }
            },
            "order": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/slug"
              }
            }
          }
        }
      }
    },
    "ageRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 125
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 125
        }
      }
    },
    "gradeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "slug",
        "title"
      ],
      "properties": {
        "type": {
          "const": "episode"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "methodology": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "locale": {
          "type": "object",
          "additionalProperties": true
        },
        "events": {
          "type": "object",
          "additionalProperties": true
        },
        "section": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items",
            "order"
          ],
          "properties": {
            "items": {
              "type": "object",
              "additionalProperties": {
                "type": "object"
              }
            },
            "order": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/slug"
              }
            }
          }
        }
      }
    }
  }
}
