{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "tsconfig*.json",
    "scripts/textbook-tooling/**",
    "scripts/ci/productionQuality/turbo-poc-*.mjs"
  ],
  "globalEnv": [
    "SVITLO_MEDIA_MODE",
    "SVITLO_TEXTBOOK",
    "npm_config_ignore_scripts"
  ],
  "tasks": {
    "package:build": {
      "dependsOn": [
        "^package:build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "code:check:types": {
      "dependsOn": [
        "package:build",
        "^package:build"
      ],
      "cache": false
    },
    "test": {
      "dependsOn": [
        "code:check:types"
      ],
      "cache": false
    }
  },
  "remoteCache": {
    "enabled": false
  }
}
