{
  "name": "@svitlo/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preapp:start:dev": "node scripts/prepareContent/prepare.mjs",
    "app:start:dev": "node scripts/buildMobile/build.mjs --serve",
    "preapp:build": "node scripts/prepareContent/prepare.mjs",
    "app:build": "node scripts/buildMobile/build.mjs",
    "precode:check:types": "node scripts/prepareContent/prepare.mjs",
    "code:check:types": "tsc -p tsconfig.json --noEmit",
    "code:lint:check": "eslint . && npm run code:check:types && node --check scripts/prepareContent/prepare.mjs && node --check scripts/buildMobile/build.mjs",
    "test": "node --test scripts/prepareContent/*.test.mjs",
    "test:e2e": "playwright test",
    "app:sync": "npm run app:build && cap sync",
    "app:open:android": "npm run app:sync && cap open android",
    "app:open:ios": "npm run app:sync && cap open ios",
    "app:native:add": "cap add android && cap add ios",
    "app:check:bundle": "node scripts/verifyBundle/verify-bundle.mjs",
    "code:format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "code:format:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "code:lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.4.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@svitlo/adapter-capacitor": "0.0.0",
    "@svitlo/engine": "0.0.0",
    "@svitlo/indexdb": "0.0.0",
    "@svitlo/playground": "0.0.0",
    "@svitlo/ui-kit": "0.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@capacitor/android": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "eslint": "^9",
    "typescript-eslint": "^8.72.0"
  }
}
