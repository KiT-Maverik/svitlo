{
  "name": "@svitlo/desktop",
  "version": "0.0.0",
  "description": "Offline-capable Electron host for Svitlo textbooks",
  "private": true,
  "type": "module",
  "scripts": {
    "app:prepare:content": "node scripts/prepareContent/prepare-content.mjs",
    "app:build:main": "node scripts/buildMain/build-main.mjs",
    "preapp:start:dev": "npm run app:prepare:content && npm run app:build:main",
    "app:start:dev": "node scripts/startDev/dev.mjs",
    "preapp:build": "npm run app:prepare:content",
    "app:build": "vite build && npm run app:build:main",
    "app:start": "electron .",
    "code:check:types": "tsc -p tsconfig.json --noEmit",
    "code:lint:check": "eslint .",
    "test": "node --test tests/packaged-content.spec.mjs tests/engine-runtime-imports.spec.mjs",
    "test:smoke": "playwright test tests/electron.smoke.spec.mjs",
    "app:pack": "npm run app:build && electron-builder --dir --publish never",
    "app:pack:win": "npm run app:build && electron-builder --win --publish never",
    "app:pack:mac": "npm run app:build && electron-builder --mac --publish never",
    "app:pack:linux": "npm run app:build && electron-builder --linux --publish never",
    "test:packaged": "playwright test tests/electron.packaged.spec.mjs",
    "code:format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "code:format:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "code:lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@svitlo/adapter-electron": "0.0.0",
    "@svitlo/contracts": "0.0.0",
    "@svitlo/engine": "0.0.0",
    "@svitlo/playground": "0.0.0",
    "@svitlo/ui-kit": "0.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "typescript": "^5",
    "vite": "^7.3.7",
    "@eslint/js": "^9.39.5",
    "typescript-eslint": "^8.72.0",
    "playwright": "^1.64.1"
  },
  "main": "dist-main/main.cjs"
}
