{
  "name": "@svitlo/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-capable Electron host for Svitlo textbooks",
  "main": "dist-main/main.cjs",
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs",
    "build:main": "node scripts/build-main.mjs",
    "predev": "npm run prepare:content && npm run build:main",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run prepare:content",
    "build": "vite build && npm run build:main",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/packaged-content.spec.mjs",
    "test:smoke": "playwright test",
    "package": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@svitlo/adapter-electron": "0.0.0",
    "@svitlo/engine": "0.0.0",
    "@svitlo/ui-kit": "0.0.0",
    "@svitlo/playground": "0.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "typescript": "^5",
    "vite": "^7.3.7",
    "@eslint/js": "^9.39.5",
    "typescript-eslint": "^8.72.0",
    "playwright": "^1.64.1"
  }
}
