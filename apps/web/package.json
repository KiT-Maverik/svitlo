{
  "name": "@svitlo/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "app:start:dev": "next dev",
    "app:build": "next build",
    "app:start": "next start",
    "code:lint:check": "eslint",
    "code:check:types": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:components": "vitest run",
    "pretest:components": "npm run app:prepare:assets && node scripts/prepareTextbook/prepare-textbook.mjs",
    "test:components:coverage": "vitest run --coverage",
    "preapp:build": "npm run app:prepare:assets && node scripts/prepareTextbook/prepare-textbook.mjs",
    "preapp:start:dev": "npm run app:prepare:assets && node scripts/prepareTextbook/prepare-textbook.mjs",
    "precode:check:types": "npm run app:prepare:assets && node scripts/prepareTextbook/prepare-textbook.mjs",
    "test:unit:selection": "node --test scripts/prepareTextbook/prepare-textbook.spec.mjs scripts/prepareAppAssets/prepare-app-assets.spec.mjs",
    "pretest:components:coverage": "npm run app:prepare:assets && node scripts/prepareTextbook/prepare-textbook.mjs",
    "app:prepare:assets": "node scripts/prepareAppAssets/prepare-app-assets.mjs",
    "code:format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "code:format:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "code:lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@svitlo/adapter-nextjs": "0.0.0",
    "@svitlo/contracts": "0.0.0",
    "@svitlo/engine": "0.0.0",
    "@svitlo/indexdb": "0.0.0",
    "@svitlo/playground": "0.0.0",
    "@svitlo/ui-kit": "0.0.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "prettier": "3.9.10",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
