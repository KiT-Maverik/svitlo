{
  "name": "svitlo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "code:format:check": "prettier --check .",
    "code:format:fix": "prettier --write .",
    "code:lint:check": "node scripts/run-workspace-script.mjs code:lint:check",
    "code:lint:fix": "node scripts/run-workspace-script.mjs code:lint:fix",
    "code:check:types": "node scripts/run-workspace-script.mjs code:check:types",
    "test": "node scripts/run-workspace-script.mjs test && node --test scripts/course-builder/build-course.spec.mjs && node --test scripts/lesson-builder.spec.mjs && node --test scripts/generators/data/prepare-skills-publication.spec.mjs && node --test scripts/generators/data/publish-course-data.spec.mjs",
    "test:e2e": "node scripts/run-workspace-script.mjs test:e2e",
    "test:components": "node scripts/run-workspace-script.mjs test:components",
    "test:components:coverage": "node scripts/run-workspace-script.mjs test:components:coverage",
    "test:taxonomy-generator": "node --test scripts/generate-skills-taxonomy.spec.mjs scripts/generate-skills-taxonomy.roundtrip.spec.mjs",
    "test:taxonomy-import": "node --test scripts/import-taxonomy-descriptions.spec.mjs",
    "package:build": "node scripts/run-workspace-script.mjs package:build",
    "app:build": "node scripts/run-workspace-script.mjs app:build",
    "app:pack": "node scripts/run-workspace-script.mjs app:pack",
    "storybook:build": "node scripts/run-workspace-script.mjs storybook:build",
    "repo:list:packages": "npm ls --workspaces --depth=0",
    "repo:check:packages": "node scripts/check-workspaces.mjs && node scripts/check-package-boundaries.mjs && node scripts/check-extraction-readiness.mjs && node scripts/check-final-architecture.mjs && node --test scripts/run-workspace-script.spec.mjs && node scripts/migrate-shared-imports.mjs --check && node --test scripts/migrate-shared-imports.spec.mjs && node scripts/check-engine-runtime-graph.mjs",
    "repo:check:artifacts": "node scripts/check-built-package-exports.mjs",
    "content:generate:lessons": "node scripts/lesson-builder.mjs generate",
    "content:check:lessons": "node scripts/lesson-builder.mjs check",
    "content:generate:lesson-props": "node scripts/generators/pages/lessons/generate-lesson-props.mjs",
    "content:check:lesson-props": "node scripts/generators/pages/lessons/generate-lesson-props.mjs",
    "test:unit:lesson-builder": "node --test scripts/lesson-builder.spec.mjs",
    "repo:check:imports": "node scripts/migrate-shared-imports.mjs --check",
    "repo:fix:imports": "node scripts/migrate-shared-imports.mjs --write",
    "content:generate:skills": "node scripts/generators/data/publish-skills-data.mjs",
    "content:check:skills": "node scripts/generators/data/publish-skills-data.mjs",
    "content:generate:course-props": "node scripts/generators/data/generate-course-props.mjs",
    "content:check:course-props": "node scripts/generators/data/generate-course-props.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "prettier": "3.9.10",
    "yaml": "2.9.1",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "apps/*",
    "backend/*",
    "content/*",
    "content/languages/*",
    "shared/*",
    "shared/adapters/*"
  ]
}
