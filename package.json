{
  "name": "svitlo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "code:format:check": "prettier --check .",
    "code:format:fix": "prettier --write .",
    "code:lint:check": "node scripts/runWorkspaceScript/run-workspace-script.mjs code:lint:check",
    "code:lint:fix": "node scripts/runWorkspaceScript/run-workspace-script.mjs code:lint:fix",
    "code:check:types": "node scripts/runWorkspaceScript/run-workspace-script.mjs code:check:types",
    "test": "node scripts/runWorkspaceScript/run-workspace-script.mjs test",
    "test:e2e": "node scripts/runWorkspaceScript/run-workspace-script.mjs test:e2e",
    "test:components": "node scripts/runWorkspaceScript/run-workspace-script.mjs test:components",
    "test:components:coverage": "node scripts/runWorkspaceScript/run-workspace-script.mjs test:components:coverage",
    "test:taxonomy-generator": "node --test shared/engine/scripts/generateSkillsTaxonomy/generate-skills-taxonomy.spec.mjs shared/engine/scripts/generateSkillsTaxonomy/generate-skills-taxonomy.roundtrip.spec.mjs",
    "test:taxonomy-import": "node --test shared/engine/scripts/importTaxonomyDescriptions/import-taxonomy-descriptions.spec.mjs",
    "package:build": "node scripts/runWorkspaceScript/run-workspace-script.mjs package:build",
    "app:build": "node scripts/runWorkspaceScript/run-workspace-script.mjs app:build",
    "app:pack": "node scripts/runWorkspaceScript/run-workspace-script.mjs app:pack",
    "storybook:build": "node scripts/runWorkspaceScript/run-workspace-script.mjs storybook:build",
    "repo:list:packages": "npm ls --workspaces --depth=0",
    "repo:check:packages": "node scripts/checkWorkspaces/check-workspaces.mjs && node scripts/checkPackageBoundaries/check-package-boundaries.mjs && node scripts/checkExtractionReadiness/check-extraction-readiness.mjs && node scripts/checkFinalArchitecture/check-final-architecture.mjs && node --test scripts/runWorkspaceScript/run-workspace-script.spec.mjs && node scripts/migrateSharedImports/migrate-shared-imports.mjs --check && node --test scripts/migrateSharedImports/migrate-shared-imports.spec.mjs",
    "repo:check:artifacts": "node scripts/checkBuiltPackageExports/check-built-package-exports.mjs",
    "content:generate:lessons": "node shared/engine/scripts/lessonBuilder/lessonBuilder.mjs generate",
    "content:check:lessons": "node shared/engine/scripts/lessonBuilder/lessonBuilder.mjs check",
    "content:generate:lesson-props": "node shared/engine/scripts/generateLessonProps/generateLessonProps.mjs",
    "content:check:lesson-props": "node shared/engine/scripts/generateLessonProps/generateLessonProps.mjs",
    "test:unit:lesson-builder": "node --test shared/engine/scripts/lessonBuilder/lessonBuilder.spec.mjs",
    "repo:check:imports": "node scripts/migrateSharedImports/migrate-shared-imports.mjs --check",
    "repo:fix:imports": "node scripts/migrateSharedImports/migrate-shared-imports.mjs --write",
    "content:generate:skills": "node shared/engine/scripts/generateSkills/generateSkills.mjs",
    "content:check:skills": "node shared/engine/scripts/generateSkills/generateSkills.mjs",
    "content:generate:course-props": "node shared/engine/scripts/generateCourseProps/generateCourseProps.mjs",
    "content:check:course-props": "node shared/engine/scripts/generateCourseProps/generateCourseProps.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "prettier": "3.9.10",
    "yaml": "2.9.1",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "apps/*",
    "backend/*",
    "content/*",
    "content/languages/*",
    "shared/*",
    "shared/adapters/*"
  ]
}
