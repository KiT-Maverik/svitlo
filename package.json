{
  "name": "svitlo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "code:format:check": "prettier --check .",
    "code:format:fix": "prettier --write .",
    "code:lint:check": "node scripts/run-workspace-script.mjs code:lint:check",
    "code:lint:fix": "node scripts/run-workspace-script.mjs code:lint:fix",
    "code:check:types": "node scripts/run-workspace-script.mjs code:check:types",
    "test": "node scripts/run-workspace-script.mjs test",
    "test:e2e": "node scripts/run-workspace-script.mjs test:e2e",
    "test:components": "node scripts/run-workspace-script.mjs test:components",
    "test:components:coverage": "node scripts/run-workspace-script.mjs test:components:coverage",
    "test:taxonomy-generator": "node --test scripts/generate-skills-taxonomy.spec.mjs scripts/generate-skills-taxonomy.roundtrip.spec.mjs",
    "test:taxonomy-import": "node --test scripts/import-taxonomy-descriptions.spec.mjs",
    "package:build": "node scripts/run-workspace-script.mjs package:build",
    "app:build": "node scripts/run-workspace-script.mjs app:build",
    "app:pack": "node scripts/run-workspace-script.mjs app:pack",
    "storybook:build": "node scripts/run-workspace-script.mjs storybook:build",
    "repo:list:packages": "npm ls --workspaces --depth=0",
    "repo:check:packages": "node scripts/check-workspaces.mjs && node scripts/check-package-boundaries.mjs && node scripts/check-extraction-readiness.mjs && node scripts/check-final-architecture.mjs && node --test scripts/run-workspace-script.spec.mjs",
    "repo:check:artifacts": "node scripts/check-built-package-exports.mjs",
    "content:generate:lessons": "node scripts/lesson-builder.mjs generate",
    "content:check:lessons": "node scripts/lesson-builder.mjs check",
    "test:unit:lesson-builder": "node --test scripts/lesson-builder.spec.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "ajv2020": "npm:ajv@8.20.0",
    "js-yaml": "4.3.2"
  },
  "workspaces": [
    "apps/*",
    "backend/*",
    "content/*",
    "content/languages/*",
    "shared/*",
    "shared/adapters/*"
  ]
}
