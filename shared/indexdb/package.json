{
  "name": "@svitlo/indexdb",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "package:build": "tsc -p tsconfig.build.json",
    "code:check:types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --experimental-test-coverage --test --test-coverage-include='.test-build/utils/**/*.js' .test-build/utils/*/*.spec.js .test-build/controllers/*/*/*.spec.js .test-build/controllers/__tests__/*.integration.test.js",
    "test:unit:db-utils": "tsc -p tsconfig.test.json && node --test .test-build/utils/*/*.spec.js",
    "test:unit:db-utils:coverage": "tsc -p tsconfig.test.json && node --experimental-test-coverage --test --test-coverage-include='.test-build/utils/**/*.js' .test-build/utils/*/*.spec.js",
    "test:integration:db:coverage": "tsc -p tsconfig.test.json && node --experimental-test-coverage --test .test-build/controllers/__tests__/*.integration.test.js",
    "test:unit:db-controllers": "tsc -p tsconfig.test.json && node --test .test-build/controllers/*/*/*.spec.js",
    "test:unit:db-controllers:coverage": "tsc -p tsconfig.test.json && node --experimental-test-coverage --test .test-build/controllers/*/*/*.spec.js",
    "prepack": "npm run package:build",
    "test:e2e:db": "playwright test --config playwright.config.ts",
    "code:format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "code:format:fix": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@svitlo/contracts": "0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "fake-indexeddb": "^6.2.6",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ]
}
