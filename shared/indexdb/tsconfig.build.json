{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "noEmit": false,
    "incremental": false
  },
  "include": ["*.ts", "controllers/**/*.ts", "schemas/**/*.ts", "utils/**/*.ts"],
  "exclude": ["node_modules", "dist", ".test-build", "**/*.spec.ts", "**/*.test.ts", "**/*.e2e.spec.ts"]
}
