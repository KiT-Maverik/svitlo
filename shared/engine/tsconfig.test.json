{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "outDir": "./.test-build",
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "configurators/**/*.ts",
    "data/**/*.ts",
    "definitions/**/*.ts",
    "lessons/**/*.ts",
    "schemas/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".test-build", "**/*.typecheck.ts"]
}
