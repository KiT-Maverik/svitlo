{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "outDir": "./.test-build",
    "types": [
      "node"
    ]
  },
  "include": [
    "index.ts",
    "builders/**/*.ts",
    "configurators/**/*.ts",
    "content/**/*.ts",
    "data/**/*.ts",
    "definitions/**/*.ts",
    "generation/**/*.ts",
    "lesson/**/*.ts",
    "lessons/**/*.ts",
    "localization/**/*.ts",
    "schemas/**/*.ts",
    "taxonomy/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".test-build",
    "**/*.typecheck.ts"
  ]
}
