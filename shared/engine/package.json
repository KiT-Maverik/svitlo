{
  "name": "@svitlo/engine",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "package:build": "tsc -p tsconfig.build.json",
    "code:check:types": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run package:build",
    "pretest": "npm run package:build",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/assemblers/assembleLessonProps/*.spec.js .test-build/assemblers/assembleCourseLesson/*.spec.js .test-build/assemblers/skills/*.spec.js .test-build/utils/builders/*/*.spec.js .test-build/configurators/_shared__configurators/validateSluggedConfiguratorMap/*.spec.js .test-build/configurators/_shared__configurators/validateOrderedKeys/*.spec.js .test-build/configurators/contentBlocks/_shared__contentBlocks/validateReplacementVariables/*.spec.js .test-build/configurators/contentBlocks/defineText/*.spec.js .test-build/configurators/contentBlocks/defineCarousel/*.spec.js .test-build/configurators/contentBlocks/defineCheckpoint/defineCheckpoint.spec.js .test-build/configurators/contentBlocks/defineCheckpoint/defineCheckpointItem/*.spec.js .test-build/configurators/contentBlocks/assembly.spec.js .test-build/configurators/contentBlocks/defineMarkdown/*.spec.js .test-build/configurators/contentBlocks/_shared__contentBlocks/validateLocalAssets/*.spec.js .test-build/utils/createDynamicQuestion/*.spec.js .test-build/utils/createLocalizedFileLocations/*.spec.js .test-build/utils/entityPath/*.spec.js .test-build/utils/generators/getMarkdownLocale/*.spec.js .test-build/utils/generators/lessons/*.spec.js .test-build/lessons/*.spec.js .test-build/configurators_old/createCourseConfigurator/createModuleConfigurator/*.spec.js .test-build/schemas/*.spec.js .test-build/configurators/questions/*.spec.js .test-build/configurators/*.spec.js .test-build/configurators/courses/defineCourse/courseHierarchy.spec.js .test-build/configurators/skills/defineSkillGroup/skillHierarchy.spec.js .test-build/configurators/assessmentMethods/defineAssessmentMethod.spec.js .test-build/configurators/sections/sectionConfigurators.spec.js .test-build/configurators/sections/defineQuizSection/*.spec.js .test-build/configurators/lessons/defineLesson/*.spec.js .test-build/configurators/episodes/defineEpisode/*.spec.js .test-build/configurators/flashcards/defineFlashcard/*.spec.js generators/skills/publishSkillTree.spec.mjs scripts/generateSkills/prepareSkillsPublication.spec.mjs generators/courses/publishCourseData.spec.mjs scripts/lessonBuilder/lessonBuilder.spec.mjs scripts/courseBuilder/courseBuilder.spec.mjs .test-build/configurators/contentBlocks/defineAudio/*.spec.js .test-build/configurators/contentBlocks/defineCode/*.spec.js .test-build/configurators/contentBlocks/defineImage/*.spec.js .test-build/configurators/contentBlocks/defineScene/*.spec.js .test-build/configurators/contentBlocks/defineVideo/*.spec.js .test-build/configurators/contentBlocks/defineYoutube/*.spec.js .test-build/configurators/contentBlocks/defineCarousel/defineCarouselSlide/*.spec.js .test-build/utils/languages/*.spec.js scripts/coverage/report.spec.mjs .test-build/generators/lessons/*.spec.js scripts/generateLessonProps/generateLessonProps.spec.mjs scripts/generateCourseProps/generateCourseProps.spec.mjs scripts/generatorCliIntegration/generatorCliIntegration.spec.mjs scripts/generateYamlSchemas/generateYamlSchemas.spec.mjs scripts/yamlDraft/yamlDraft.integration.spec.mjs && node ../../scripts/checkEngineRuntimeGraph/check-engine-runtime-graph.mjs",
    "test:coverage": "node scripts/coverage/run.mjs",
    "code:format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "code:format:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "test:contentblocks": "tsc -p tsconfig.build.json --declaration false && tsc -p tsconfig.contentblocks.json && node --test .test-build/configurators/contentBlocks.asset-validation.spec.js .test-build/configurators/contentBlocks/assembly.spec.js .test-build/configurators/contentBlocks/defineText/*.spec.js .test-build/configurators/contentBlocks/defineMarkdown/*.spec.js .test-build/configurators/contentBlocks/defineCarousel/*.spec.js .test-build/configurators/contentBlocks/defineCheckpoint/*.spec.js .test-build/configurators/contentBlocks/defineCheckpoint/defineCheckpointItem/*.spec.js .test-build/configurators/contentBlocks/defineAudio/*.spec.js .test-build/configurators/contentBlocks/defineCode/*.spec.js .test-build/configurators/contentBlocks/defineImage/*.spec.js .test-build/configurators/contentBlocks/defineScene/*.spec.js .test-build/configurators/contentBlocks/defineVideo/*.spec.js .test-build/configurators/contentBlocks/defineYoutube/*.spec.js .test-build/configurators/contentBlocks/defineCarousel/defineCarouselSlide/*.spec.js",
    "content:generate:yaml-schemas": "node scripts/generateYamlSchemas/generateYamlSchemas.mjs --write",
    "content:check:yaml-schemas": "node scripts/generateYamlSchemas/generateYamlSchemas.mjs --check"
  },
  "dependencies": {
    "@svitlo/contracts": "0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "esbuild": "^0.28.2"
  },
  "exports": {
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#configurators": "./dist/configurators/index.js",
    "#lessons": "./dist/lessons/index.js",
    "#schemas": "./dist/schemas/index.js",
    "#utils": "./dist/utils/index.js",
    "#types": "./dist/types/index.js"
  }
}
