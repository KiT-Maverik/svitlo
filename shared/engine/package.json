{
  "name": "@svitlo/engine",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/utils/builders/*/*.spec.js .test-build/utils/createDynamicQuestion/*.spec.js .test-build/utils/createLocalizedFileLocations/*.spec.js .test-build/utils/generators/getMarkdownLocale/*.spec.js .test-build/utils/generators/lessons/*.spec.js .test-build/data/assessmentMethodTaxonomy/*.spec.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./localization": {
      "types": "./dist/localization.d.ts",
      "default": "./dist/localization.js"
    },
    "./taxonomy": {
      "types": "./dist/taxonomy.d.ts",
      "default": "./dist/taxonomy.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./builders": {
      "types": "./dist/builders.d.ts",
      "default": "./dist/builders.js"
    },
    "./generation": {
      "types": "./dist/generation.d.ts",
      "default": "./dist/generation.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./assessment-methods": {
      "types": "./dist/assessment-methods.d.ts",
      "default": "./dist/assessment-methods.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "esbuild": "^0.28.2"
  },
  "typesVersions": {
    "*": {
      "localization": [
        "dist/localization.d.ts"
      ],
      "taxonomy": [
        "dist/taxonomy.d.ts"
      ],
      "content": [
        "dist/content.d.ts"
      ],
      "builders": [
        "dist/builders.d.ts"
      ],
      "generation": [
        "dist/generation.d.ts"
      ],
      "utils": [
        "dist/utils.d.ts"
      ],
      "types": [
        "dist/types.d.ts"
      ],
      "assessment-methods": [
        "dist/assessment-methods.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "dependencies": {
    "@svitlo/contracts": "0.0.0"
  }
}
