{
  "name": "@svitlo/engine",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "package:build": "tsc -p tsconfig.build.json",
    "code:check:types": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run package:build",
    "pretest": "npm run package:build",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/utils/builders/*/*.spec.js .test-build/utils/createDynamicQuestion/*.spec.js .test-build/utils/createLocalizedFileLocations/*.spec.js .test-build/utils/entityPath/*.spec.js .test-build/utils/generators/getMarkdownLocale/*.spec.js .test-build/utils/generators/lessons/*.spec.js .test-build/lessons/*.spec.js .test-build/data/assessmentMethodTaxonomy/*.spec.js .test-build/configurators/createCourseConfigurator/createModuleConfigurator/*.spec.js .test-build/schemas/*.spec.js",
    "code:format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "code:format:fix": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@svitlo/contracts": "0.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "esbuild": "^0.28.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "imports": {
    "#configurators": "./dist/configurators/index.js",
    "#data": "./dist/data/index.js",
    "#definitions": "./dist/definitions/index.js",
    "#lessons": "./dist/lessons/index.js",
    "#schemas": "./dist/schemas/index.js",
    "#utils": "./dist/utils/index.js"
  }
}
