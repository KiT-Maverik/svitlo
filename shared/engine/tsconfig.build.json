{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "noEmit": false,
    "incremental": false
  },
  "include": [
    "index.ts",
    "configurators/**/*.ts",
    "data/**/*.ts",
    "definitions/**/*.ts",
    "lessons/**/*.ts",
    "schemas/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.unit.spec.ts", "**/*.typecheck.ts"]
}
