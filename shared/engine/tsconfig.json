{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@src": ["src/*"],
      "@configurators": ["configurators"],
      "@data": ["data"],
      "@definitions": ["definitions"],
      "@lessons": ["lessons"],
      "@schemas": ["schemas"],
      "@types": ["types"],
      "@utils": ["utils"],
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "definitions/**/*.ts",
    "configurators/**/*.ts",
    "data/**/*.ts",
    "lessons/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts",
    "schemas/**/*.ts"
  ]
}
