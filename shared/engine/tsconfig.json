{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@definitions": ["definitions"],
      "@definitions/*": ["definitions/*"],
      "@schemas": ["schemas"],
      "@schemas/*": ["schemas/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src/**/*.ts", "definitions/**/*.ts", "schemas/**/*.ts"]
}
