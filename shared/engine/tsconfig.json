{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "#configurators": [
        "configurators/index.ts"
      ],
      "#data": [
        "data/index.ts"
      ],
      "#definitions": [
        "definitions/index.ts"
      ],
      "#lessons": [
        "lessons/index.ts"
      ],
      "#schemas": [
        "schemas/index.ts"
      ],
      "#types": [
        "types/index.ts"
      ],
      "#utils": [
        "utils/index.ts"
      ]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "index.ts",
    "configurators/**/*.ts",
    "data/**/*.ts",
    "definitions/**/*.ts",
    "lessons/**/*.ts",
    "schemas/**/*.ts",
    "types/**/*.ts",
    "utils/**/*.ts"
  ]
}
