{
  "name": "@svitlo/adapter-electron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    },
    "./resources": {
      "types": "./dist/resourcePath.d.ts",
      "default": "./dist/resourcePath.js"
    }
  },
  "scripts": {
    "package:build": "tsc -p tsconfig.build.json",
    "code:check:types": "tsc -p tsconfig.json --noEmit",
    "test": "npm run package:build && node --test tests/*.spec.mjs",
    "code:format:check": "prettier --check . --ignore-path ../../../.prettierignore",
    "code:format:fix": "prettier --write . --ignore-path ../../../.prettierignore"
  },
  "dependencies": {
    "@svitlo/engine": "0.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "electron": "45.2.2",
    "typescript": "^5"
  }
}
