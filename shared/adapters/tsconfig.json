{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "nextjs/src/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "nextjs/src/**/*.ts",
    "nextjs/src/**/*.tsx"
  ]
}
