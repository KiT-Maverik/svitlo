{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "./nextjs/src",
    "outDir": "./dist/nextjs",
    "declaration": true,
    "noEmit": false
  },
  "include": [
    "nextjs/src/**/*.ts",
    "nextjs/src/**/*.tsx"
  ]
}
