{
  "name": "@svitlo/adapter",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "exports": {
    "./nextjs": {
      "types": "./dist/nextjs/index.d.ts",
      "default": "./dist/nextjs/index.js"
    },
    "./nextjs/lesson": {
      "types": "./dist/nextjs/lesson.d.ts",
      "default": "./dist/nextjs/lesson.js"
    },
    "./nextjs/image": {
      "types": "./dist/nextjs/image.d.ts",
      "default": "./dist/nextjs/image.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@svitlo/engine": "0.0.0",
    "@svitlo/ui-kit": "0.0.0"
  },
  "peerDependencies": {
    "next": "16.4.2",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "next": "16.4.2",
    "react": "19.3.0",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
