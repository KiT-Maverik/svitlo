{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "noEmitOnError": true
  },
  "include": ["index.ts", "data/**/*.ts", "catalog.spec.ts"],
  "exclude": ["node_modules", "dist"]
}
