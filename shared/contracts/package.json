{
  "name": "@svitlo/contracts",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/types/content/assessmentMethod.ids.spec.js",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./content": {
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./taxonomy": {
      "types": "./dist/taxonomy.d.ts",
      "default": "./dist/taxonomy.js"
    },
    "./localization": {
      "types": "./dist/localization.d.ts",
      "default": "./dist/localization.js"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "default": "./dist/state.js"
    }
  },
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "localization": [
        "dist/localization.d.ts"
      ],
      "taxonomy": [
        "dist/taxonomy.d.ts"
      ],
      "content": [
        "dist/content.d.ts"
      ],
      "state": [
        "dist/state.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  }
}
