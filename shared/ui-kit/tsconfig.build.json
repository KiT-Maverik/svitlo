{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "rootDir": ".",
    "outDir": "./dist",
    "declaration": true,
    "noEmit": false,
    "incremental": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    ".test-build",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.stories.tsx",
    "**/*.typecheck.ts",
    "**/*.unit.fx.ts",
    "**/*.unit.mx.ts"
  ]
}
