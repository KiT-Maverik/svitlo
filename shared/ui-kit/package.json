{
  "name": "@svitlo/ui-kit",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#layout/*": "./dist/components/layout/*.js",
    "#widgets/*": "./dist/components/widgets/*.js",
    "#testing/*": "./dist/testing/*.js",
    "#types/*": "./dist/types/*.js",
    "#utils/*": "./dist/utils/*.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "default": "./dist/widgets.js"
    },
    "./questions": {
      "types": "./dist/questions.d.ts",
      "default": "./dist/questions.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "default": "./dist/navigation.js"
    },
    "./widgets/*": {
      "types": "./dist/components/widgets/*.d.ts",
      "default": "./dist/components/widgets/*.js"
    },
    "./questions/*": {
      "types": "./dist/components/widgets/questions/*.d.ts",
      "default": "./dist/components/widgets/questions/*.js"
    },
    "./navigation/*": {
      "types": "./dist/components/layout/Navigation/*.d.ts",
      "default": "./dist/components/layout/Navigation/*.js"
    },
    "./learning-layout": {
      "types": "./dist/components/layout/LearningLayout/index.d.ts",
      "default": "./dist/components/layout/LearningLayout/index.js"
    },
    "./sync-flags": {
      "default": "./scripts/sync-flags.mjs"
    },
    "./learning-layout/preferences": {
      "types": "./dist/components/layout/LearningLayout/NavbarPreferences/NavbarPreferences.d.ts",
      "default": "./dist/components/layout/LearningLayout/NavbarPreferences/NavbarPreferences.js"
    },
    "./lesson": {
      "types": "./dist/components/lesson/index.d.ts",
      "default": "./dist/components/lesson/index.js"
    }
  },
  "files": [
    "dist",
    "assets/flags",
    "scripts/sync-flags.mjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.data.json --noEmit",
    "test:logic": "npm run typecheck",
    "test:components": "vitest run",
    "test": "npm run test:logic && npm run test:components",
    "prepack": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@svitlo/engine": "0.0.0",
    "highlight.js": "^11.12.0"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/nextjs": "^10.6.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "next": "16.4.2",
    "storybook": "^10.6.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
