{
  "name": "@svitlo/ui-kit",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "imports": {
    "#layout/*": "./dist/src/components/layout/*.js",
    "#widgets/*": "./dist/src/components/widgets/*.js",
    "#testing/*": "./dist/src/testing/*.js",
    "#types/*": "./dist/src/types/*.js",
    "#utils/*": "./dist/src/utils/*.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./widgets": {
      "types": "./dist/src/widgets.d.ts",
      "default": "./dist/src/widgets.js"
    },
    "./questions": {
      "types": "./dist/src/questions.d.ts",
      "default": "./dist/src/questions.js"
    },
    "./navigation": {
      "types": "./dist/src/navigation.d.ts",
      "default": "./dist/src/navigation.js"
    },
    "./widgets/*": {
      "types": "./dist/src/components/widgets/*.d.ts",
      "default": "./dist/src/components/widgets/*.js"
    },
    "./questions/*": {
      "types": "./dist/src/components/widgets/questions/*.d.ts",
      "default": "./dist/src/components/widgets/questions/*.js"
    },
    "./navigation/*": {
      "types": "./dist/src/components/layout/Navigation/*.d.ts",
      "default": "./dist/src/components/layout/Navigation/*.js"
    },
    "./layout": {
      "types": "./dist/src/layout.d.ts",
      "default": "./dist/src/layout.js"
    },
    "./layout/*": {
      "types": "./dist/src/components/layout/*.d.ts",
      "default": "./dist/src/components/layout/*.js"
    },
    "./user-cabinet": {
      "types": "./dist/src/components/pages/UserCabinet/index.d.ts",
      "default": "./dist/src/components/pages/UserCabinet/index.js"
    },
    "./learning-layout": {
      "types": "./dist/src/components/layout/LearningLayout/index.d.ts",
      "default": "./dist/src/components/layout/LearningLayout/index.js"
    },
    "./sync-flags": {
      "default": "./scripts/sync-flags.mjs"
    },
    "./learning-layout/preferences": {
      "types": "./dist/src/components/layout/LearningLayout/NavbarPreferences/NavbarPreferences.d.ts",
      "default": "./dist/src/components/layout/LearningLayout/NavbarPreferences/NavbarPreferences.js"
    },
    "./theme": {
      "types": "./dist/src/theme.d.ts",
      "default": "./dist/src/theme.js"
    },
    "./lesson": {
      "types": "./dist/src/components/lesson/index.d.ts",
      "default": "./dist/src/components/lesson/index.js"
    },
    "./scene-locale": {
      "types": "./dist/src/scene-locale.d.ts",
      "default": "./dist/src/scene-locale.js"
    },
    "./course": {
      "types": "./dist/src/course.d.ts",
      "default": "./dist/src/course.js"
    }
  },
  "files": [
    "dist",
    "assets/flags",
    "scripts/sync-flags.mjs"
  ],
  "scripts": {
    "package:build": "node scripts/build.mjs",
    "code:check:types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.data.json --noEmit",
    "test:logic": "npm run code:check:types && npm run test:locales",
    "test:components": "vitest run",
    "test": "npm run test:logic && npm run test:components",
    "prepack": "npm run package:build",
    "storybook:start": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:locales": "node --test scripts/generate-locales.spec.mjs scripts/sync-flags.spec.mjs",
    "code:format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "code:format:fix": "prettier --write . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@svitlo/engine": "0.0.0",
    "highlight.js": "^11.12.0"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/nextjs": "^10.6.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "next": "16.4.2",
    "storybook": "^10.6.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
